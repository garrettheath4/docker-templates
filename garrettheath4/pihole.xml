<?xml version="1.0"?>
<Container version="2">
  <Name>pihole</Name>
  <Repository>pihole/pihole:latest</Repository>
  <Registry>https://registry.hub.docker.com/r/diginc/pi-hole</Registry>
  <Network>br0</Network>
  <MyIP>10.0.4.2</MyIP>
  <Shell>sh</Shell>
  <Privileged>false</Privileged>
  <Support>https://lime-technology.com/forum/index.php?topic=50453.0</Support>
  <Project/>
  <Overview>
    Pi-Hole - let's block those pesky ads![br][br]
    This is a template for the official PiHole Docker[br]
    Make sure that you use bridge mode and give PiHole[br]
    it's own IP address.[br]
    Also, if you set you router to give out the PiHole address to clients,[br]
    make sure that you fix the unRaid servers dns to point to a real DNS Server.[br]
	Please check https://hub.docker.com/r/pihole/pihole for additioanl variables that you may need.[br]
  </Overview>
  <Category>Network:Other Other:</Category>
  <WebUI>http://pihole.gh4.pw:[PORT:80]/admin</WebUI>
  <TemplateURL>https://raw.githubusercontent.com/garrettheath4/docker-templates/master/garrettheath4/pihole.xml</TemplateURL>
  <Icon>https://raw.githubusercontent.com/garrettheath4/docker-templates/master/garrettheath4/img/pihole-logo.png</Icon>
  <ExtraParams>--cap-add=NET_ADMIN --dns 127.0.0.1 --dns 1.1.1.1 --restart=unless-stopped</ExtraParams>
  <PostArgs/>
  <CPUset/>
  <DateInstalled>1631295604</DateInstalled>
  <DonateText/>
  <DonateLink/>
  <Description>&#xD;
    [b]SEP.2018:[/b]Added Variables as suggested by semtex41[br]&#xD;
    Inspired by Pi-Hole - let's block those pesky ads![br][br]&#xD;
    This Version 2 of the template is now self contained[br]&#xD;
    [br]Please note that the directories have changed[br]&#xD;
    so that you will need to add your previous WHitelist and Blacklists.[br]&#xD;
    Cron jobs are run by using your TimeZone - see TZ variable[br]&#xD;
    This is a fork of diginc/docker-pi-hole who did all the hard work[br][br]&#xD;
    which I then tuned to the unRaid template system and removed the IPV6 reference.[br][br]&#xD;
    Just set your DNS on your PC/Mac/Mobile to point to your unRaid servers IP[br]&#xD;
    and pihole will forward valid requests to your defined DNS servers.[br]&#xD;
    Point your Routers DNS server address to unRaid to cover your whole network!.[br][br]&#xD;
    [b][span style='color: #E80000;']Directions:[/span][/b][br]&#xD;
    [b]Setup IS required![/b] : Please see the environment variables.[br]&#xD;
    Allows the use of Whitelists and Blacklists.[br]&#xD;
    Web based admin on serverip/admin *** Make sure that you change unRaid's[br]&#xD;
    default port as this uses port 80 or use Unraid 6.4 to set this to its own IP address[br][br]&#xD;
  </Description>
  <Networking>
    <Mode>br0</Mode>
    <Publish>
      <Port>
        <HostPort>53</HostPort>
        <ContainerPort>53</ContainerPort>
        <Protocol>tcp</Protocol>
      </Port>
      <Port>
        <HostPort>53</HostPort>
        <ContainerPort>53</ContainerPort>
        <Protocol>udp</Protocol>
      </Port>
      <Port>
        <HostPort>80</HostPort>
        <ContainerPort>80</ContainerPort>
        <Protocol>tcp</Protocol>
      </Port>
    </Publish>
  </Networking>
  <Data>
    <Volume>
      <HostDir>/mnt/user/appdata/pihole/pihole/</HostDir>
      <ContainerDir>/etc/pihole/</ContainerDir>
      <Mode>rw</Mode>
    </Volume>
    <Volume>
      <HostDir>/mnt/user/appdata/pihole/dnsmasq.d/</HostDir>
      <ContainerDir>/etc/dnsmasq.d/</ContainerDir>
      <Mode>rw</Mode>
    </Volume>
  </Data>
  <Environment>
    <Variable>
      <Value>99</Value>
      <Name>PUID</Name>
      <Mode/>
    </Variable>
    <Variable>
      <Value>100</Value>
      <Name>PGID</Name>
      <Mode/>
    </Variable>
    <Variable>
      <Value>10.0.4.2</Value>
      <Name>ServerIP</Name>
      <Mode/>
    </Variable>
    <Variable>
      <Value/>
      <Name>ServerIPv6</Name>
      <Mode/>
    </Variable>
    <Variable>
      <Value>1.1.1.2</Value>
      <Name>DNS1</Name>
      <Mode/>
    </Variable>
    <Variable>
      <Value>1.0.0.2</Value>
      <Name>DNS2</Name>
      <Mode/>
    </Variable>
    <Variable>
      <Value>False</Value>
      <Name>IPv6</Name>
      <Mode/>
    </Variable>
    <Variable>
      <Value>America/New_York</Value>
      <Name>TZ</Name>
      <Mode/>
    </Variable>
    <Variable>
      <Value></Value>
      <Name>WEBPASSWORD</Name>
      <Mode/>
    </Variable>
    <Variable>
      <Value>eth0</Value>
      <Name>INTERFACE</Name>
      <Mode/>
    </Variable>
    <Variable>
      <Value>all</Value>
      <Name>DNSMASQ_LISTENING</Name>
      <Mode/>
    </Variable>
  </Environment>
  <Labels/>
  <Config Name="TCP DNS Port" Target="53" Default="53" Mode="tcp" Description="" Type="Port" Display="always" Required="true" Mask="false">53</Config>
  <Config Name="UDP DNS Port" Target="53" Default="53" Mode="udp" Description="" Type="Port" Display="always" Required="true" Mask="false">53</Config>
  <Config Name="HTTP port" Target="80" Default="80" Mode="tcp" Description="" Type="Port" Display="always" Required="true" Mask="false">80</Config>
  <Config Name="Host Pihole directory" Target="/etc/pihole/" Default="/mnt/user/appdata/pihole/pihole/" Mode="rw" Description="" Type="Path" Display="always" Required="true" Mask="false">/mnt/user/appdata/pihole/pihole/</Config>
  <Config Name="Host dnsmasq directory" Target="/etc/dnsmasq.d/" Default="/mnt/user/appdata/pihole/dnsmasq.d/" Mode="rw" Description="" Type="Path" Display="always" Required="true" Mask="false">/mnt/user/appdata/pihole/dnsmasq.d/</Config>
  <Config Name="Key 1" Target="PUID" Default="99" Mode="" Description="Container Variable: PUID" Type="Variable" Display="always" Required="false" Mask="false">99</Config>
  <Config Name="Key 2" Target="PGID" Default="100" Mode="" Description="Container Variable: PGID" Type="Variable" Display="always" Required="false" Mask="false">100</Config>
  <Config Name="ServerIP" Target="ServerIP" Default="192.168.1.24" Mode="" Description="Set to your Pihole containers LAN IP, used by web block modes and lighttpd bind address" Type="Variable" Display="always" Required="false" Mask="false">10.0.4.2</Config>
  <Config Name="ServerIPv6" Target="ServerIPv6" Default="" Mode="" Description="" Type="Variable" Display="always" Required="false" Mask="false"/>
  <Config Name="Key 5" Target="DNS1" Default="8.8.8.8" Mode="" Description="Container Variable: DNS1" Type="Variable" Display="always" Required="false" Mask="false">1.1.1.2</Config>
  <Config Name="Key 6" Target="DNS2" Default="8.8.4.4" Mode="" Description="Container Variable: DNS2" Type="Variable" Display="always" Required="false" Mask="false">1.0.0.2</Config>
  <Config Name="IPv6" Target="IPv6" Default="False" Mode="" Description="For unraid compatibility, strips out all the IPv6 configuration from DNS/Web services when false." Type="Variable" Display="always" Required="false" Mask="false">False</Config>
  <Config Name="Timezone" Target="TZ" Default="Europe/London" Mode="" Description="" Type="Variable" Display="always" Required="false" Mask="false">America/New_York</Config>
  <Config Name="WEBPASSWORD" Target="WEBPASSWORD" Default="admin" Mode="" Description="" Type="Variable" Display="always" Required="false" Mask="false"></Config>
  <Config Name="INTERFACE" Target="INTERFACE" Default="br0" Mode="" Description="" Type="Variable" Display="always" Required="false" Mask="false">eth0</Config>
  <Config Name="DNSMASQ_LISTENING" Target="DNSMASQ_LISTENING" Default="all" Mode="" Description="local listens on all local subnets, all permits listening on internet origin subnets in addition to local, single listens only on the interface specified." Type="Variable" Display="always" Required="false" Mask="false">all</Config>
  <Config Name="Required Port" Target="67" Default="67" Mode="udp" Description="" Type="Port" Display="always" Required="true" Mask="false">67</Config>
  <Config Name="HTTPS Port" Target="443" Default="443" Mode="tcp" Description="" Type="Port" Display="always" Required="true" Mask="false">443</Config>
  <Config Name="PIHOLE_DNS_" Target="PIHOLE_DNS_" Default="8.8.8.8;8.8.4.4" Mode="" Description="Upstream DNS server(s) for Pi-hole to forward queries to, seperated by a semicolon&#13;&#10;(supports non-standard ports with #[port number]) e.g 127.0.0.1#5053;8.8.8.8;8.8.4.4" Type="Variable" Display="always" Required="false" Mask="false">8.8.8.8;8.8.4.4</Config>
  <Config Name="WEBUI BOXED LAYOUT" Target="WEBUIBOXEDLAYOUT" Default="boxed" Mode="" Description="Use boxed layout (helpful when working on large screens)" Type="Variable" Display="always" Required="false" Mask="false">boxed</Config>
</Container>
