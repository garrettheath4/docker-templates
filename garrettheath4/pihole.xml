<?xml version="1.0"?>
<Container version="2">
  <Name>pihole</Name>
  <Repository>pihole/pihole:latest</Repository>
  <Registry>https://registry.hub.docker.com/r/diginc/pi-hole</Registry>
  <Network>br0</Network>
  <MyIP>192.168.4.3</MyIP>
  <MyMAC/>
  <Shell>sh</Shell>
  <Privileged>false</Privileged>
  <Support>https://lime-technology.com/forum/index.php?topic=50453.0</Support>
  <Project/>
  <ReadMe/>
  <Overview>&#xD;
    Pi-Hole - let's block those pesky ads!&#xD;
&#xD;
&#xD;
    This is a template for the official PiHole Docker&#xD;
&#xD;
    Make sure that you use bridge mode and give PiHole&#xD;
&#xD;
    it's own IP address.&#xD;
&#xD;
    Also, if you set you router to give out the PiHole address to clients,&#xD;
&#xD;
    make sure that you fix the unRaid servers dns to point to a real DNS Server.&#xD;
&#xD;
	Please check https://hub.docker.com/r/pihole/pihole for additioanl variables that you may need.&#xD;
&#xD;
  </Overview>
  <Category>Network:Other Other:</Category>
  <WebUI>http://pihole.gh4.red:[PORT:80]/admin</WebUI>
  <TemplateURL>https://raw.githubusercontent.com/garrettheath4/docker-templates/master/garrettheath4/pihole.xml</TemplateURL>
  <Icon>https://raw.githubusercontent.com/garrettheath4/docker-templates/master/garrettheath4/img/pihole-logo.png</Icon>
  <ExtraParams>--cap-add=NET_ADMIN --dns 127.0.0.1 --dns 1.1.1.2 --restart=unless-stopped --hostname pihole</ExtraParams>
  <PostArgs/>
  <CPUset/>
  <DateInstalled>1795139723</DateInstalled>
  <DonateText/>
  <DonateLink/>
  <Requires/>
  <Config Name="TCP DNS Port" Target="53" Default="53" Mode="tcp" Description="" Type="Port" Display="always" Required="true" Mask="false">53</Config>
  <Config Name="UDP DNS Port" Target="53" Default="53" Mode="udp" Description="" Type="Port" Display="always" Required="true" Mask="false">53</Config>
  <Config Name="HTTP port" Target="80" Default="80" Mode="tcp" Description="" Type="Port" Display="always" Required="true" Mask="false">80</Config>
  <Config Name="Host Pihole directory" Target="/etc/pihole/" Default="/mnt/user/appdata/pihole/pihole/" Mode="rw" Description="" Type="Path" Display="always" Required="true" Mask="false">/mnt/user/appdata/pihole/pihole/</Config>
  <Config Name="Host dnsmasq directory" Target="/etc/dnsmasq.d/" Default="/mnt/user/appdata/pihole/dnsmasq.d/" Mode="rw" Description="" Type="Path" Display="always" Required="true" Mask="false">/mnt/user/appdata/pihole/dnsmasq.d/</Config>
  <Config Name="Key 1" Target="PUID" Default="99" Mode="" Description="" Type="Variable" Display="always" Required="false" Mask="false">99</Config>
  <Config Name="Key 2" Target="PGID" Default="100" Mode="" Description="" Type="Variable" Display="always" Required="false" Mask="false">100</Config>
  <Config Name="ServerIP" Target="ServerIP" Default="192.168.1.24" Mode="" Description="Set to your Pihole containers LAN IP, used by web block modes and lighttpd bind address" Type="Variable" Display="always" Required="false" Mask="false">192.168.4.3</Config>
  <Config Name="ServerIPv6" Target="ServerIPv6" Default="" Mode="" Description="" Type="Variable" Display="always" Required="false" Mask="false"/>
  <Config Name="Key 5" Target="DNS1" Default="8.8.8.8" Mode="" Description="" Type="Variable" Display="always" Required="false" Mask="false">1.1.1.2</Config>
  <Config Name="Key 6" Target="DNS2" Default="8.8.4.4" Mode="" Description="" Type="Variable" Display="always" Required="false" Mask="false">1.0.0.2</Config>
  <Config Name="IPv6" Target="IPv6" Default="False" Mode="" Description="For unraid compatibility, strips out all the IPv6 configuration from DNS/Web services when false." Type="Variable" Display="always" Required="false" Mask="false">False</Config>
  <Config Name="Timezone" Target="TZ" Default="Europe/London" Mode="" Description="" Type="Variable" Display="always" Required="false" Mask="false">America/New_York</Config>
  <Config Name="WEBPASSWORD" Target="WEBPASSWORD" Default="admin" Mode="" Description="" Type="Variable" Display="always" Required="false" Mask="true"/>
  <Config Name="INTERFACE" Target="INTERFACE" Default="br0" Mode="" Description="" Type="Variable" Display="always" Required="false" Mask="false">eth0</Config>
  <Config Name="DNSMASQ_LISTENING" Target="DNSMASQ_LISTENING" Default="all" Mode="" Description="local listens on all local subnets, all permits listening on internet origin subnets in addition to local, single listens only on the interface specified." Type="Variable" Display="always" Required="false" Mask="false">all</Config>
  <Config Name="Required Port" Target="67" Default="67" Mode="udp" Description="" Type="Port" Display="always" Required="true" Mask="false">67</Config>
  <Config Name="HTTPS Port" Target="443" Default="443" Mode="tcp" Description="" Type="Port" Display="always" Required="true" Mask="false">443</Config>
  <Config Name="PIHOLE_DNS_" Target="PIHOLE_DNS_" Default="8.8.8.8;8.8.4.4" Mode="" Description="Upstream DNS server(s) for Pi-hole to forward queries to, seperated by a semicolon&#xD;&#10;(supports non-standard ports with #[port number]) e.g 127.0.0.1#5053;8.8.8.8;8.8.4.4" Type="Variable" Display="always" Required="false" Mask="false">1.1.1.2;1.0.0.2;8.8.8.8;8.8.4.4</Config>
  <Config Name="WEBUI BOXED LAYOUT" Target="WEBUIBOXEDLAYOUT" Default="boxed" Mode="" Description="Use boxed layout (helpful when working on large screens)" Type="Variable" Display="always" Required="false" Mask="false">NOTboxed</Config>
  <Config Name="Traefik Enable" Target="traefik.enable" Default="false" Mode="" Description="" Type="Label" Display="always" Required="false" Mask="false">false</Config>
  <Config Name="CORS Allowed Hosts" Target="CORS_HOSTS" Default="homer.gh4.red" Mode="" Description="" Type="Variable" Display="always" Required="false" Mask="false">https://homer.gh4.red</Config>
  <Config Name="FTL Webserver Domain" Target="FTLCONF_webserver_domain" Default="pihole.gh4.red" Mode="" Description="" Type="Variable" Display="always" Required="false" Mask="false">pihole.gh4.red</Config>
  <TailscaleStateDir/>
</Container>
