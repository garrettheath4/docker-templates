<?xml version="1.0"?>
<Container version="2">
  <Name>Insync</Name>
  <Repository>garrettheath4/docker-insync</Repository>
  <Registry>https://registry.hub.docker.com/u/garrettheath4/docker-insync/</Registry>
  <Network>bridge</Network>
  <MyIP/>
  <MyMAC/>
  <Shell>sh</Shell>
  <Privileged>false</Privileged>
  <Support/>
  <Project/>
  <ReadMe/>
  <Overview>&#xD;
    Insync extends Drive's web functionality to your desktop by integrating tightly with Windows, Mac and Linux so you can get work done.&#xD;
  </Overview>
  <Category>Cloud:</Category>
  <WebUI/>
  <TemplateURL>https://raw.githubusercontent.com/garrettheath4/docker-templates/master/garrettheath4/Insync.xml</TemplateURL>
  <Icon>https://raw.githubusercontent.com/garrettheath4/docker-templates/master/garrettheath4/img/insync-logo.png</Icon>
  <ExtraParams/>
  <PostArgs/>
  <CPUset/>
  <DateInstalled>1795133535</DateInstalled>
  <DonateText/>
  <DonateLink/>
  <Requires/>
  <Config Name="Google Account (email)" Target="GDRIVE_ACCOUNT" Default="example@gmail.com" Mode="" Description="" Type="Variable" Display="always" Required="true" Mask="false"/>
  <Config Name="Google Authentication Code" Target="GDRIVE_AUTHCODE" Default="4/1a2b3c" Mode="" Description="" Type="Variable" Display="always" Required="true" Mask="true"/>
  <Config Name="File Storage Location" Target="/data" Default="/mnt/user/appdata/Insync/data" Mode="rw" Description="" Type="Path" Display="always" Required="true" Mask="false">/mnt/user/appdata/Insync/data</Config>
  <Config Name="Configuration" Target="/root/.config/Insync" Default="/mnt/user/appdata/Insync/config" Mode="rw" Description="" Type="Path" Display="always" Required="false" Mask="false">/mnt/user/appdata/Insync/config</Config>
  <Config Name="QTWEBENGINE_DISABLE_SANDBOX=1" Target="QTWEBENGINE_DISABLE_SANDBOX" Default="1" Mode="" Description="Allows insync-headless to run as root" Type="Variable" Display="always" Required="false" Mask="false">1</Config>
  <TailscaleStateDir/>
</Container>
