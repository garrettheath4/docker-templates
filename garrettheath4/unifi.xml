<?xml version="1.0"?>
<Container version="2">
  <Name>unifi</Name>
  <Repository>linuxserver/unifi-controller</Repository>
  <Registry>https://hub.docker.com/r/linuxserver/unifi-controller/</Registry>
  <Network>host</Network>
  <MyIP/>
  <MyMAC/>
  <Shell>bash</Shell>
  <Privileged>false</Privileged>
  <Support>https://forums.unraid.net/topic/78060-support-linuxserverio-unifi-controller/</Support>
  <Project>https://www.ui.com/software/</Project>
  <ReadMe/>
  <Overview>&#xD;
The UniFi® Controller software is a powerful, enterprise wireless software engine ideal for high-density client deployments requiring low latency and high uptime performance.&#xD;
&#xD;
&#xD;
&#xD;
Available Branches&#xD;
&#xD;
Warning!The latest tag may be broken or buggy (and often is!)&#xD;
&#xD;
latest - The most recent build version of the Controller software, regardless of release train.&#xD;
&#xD;
LTS - The most recent Long Term Support release.&#xD;
&#xD;
5.9 - The most recent 5.9.x release.&#xD;
&#xD;
5.8 - The most recent 5.8.x release.&#xD;
&#xD;
5.7 - The most recent 5.7.x release.&#xD;
&#xD;
&#xD;
&#xD;
Optional Ports (Not Mapped By Default)&#xD;
&#xD;
6789 (TCP) - Port used for UniFi mobile speed test.&#xD;
&#xD;
5656-5699 (UDP) - Ports used by AP-EDU broadcasting.&#xD;
&#xD;
1900 (UDP) - Port used for "Make controller discoverable on L2 network" in controller settings.&#xD;
&#xD;
27117 (TCP) - Port used for local-bound database communication.&#xD;
</Overview>
  <Category>Tools: Network:Management</Category>
  <WebUI>https://unifi.gh4.red:[PORT:8443]</WebUI>
  <TemplateURL>https://raw.githubusercontent.com/garrettheath4/docker-templates/master/garrettheath4/unifi-controller.xml</TemplateURL>
  <Icon>https://raw.githubusercontent.com/garrettheath4/docker-templates/master/garrettheath4/img/unifi-controller-logo.png</Icon>
  <ExtraParams/>
  <PostArgs>&amp;amp;&amp;amp; docker network connect traefik unifi</PostArgs>
  <CPUset/>
  <DateInstalled>1778340280</DateInstalled>
  <DonateText/>
  <DonateLink/>
  <Requires/>
  <Config Name="Port used for STUN." Target="3478" Default="" Mode="udp" Description="Port used for STUN." Type="Port" Display="always" Required="false" Mask="false">3478</Config>
  <Config Name="Port used for device and controller communication." Target="8080" Default="" Mode="tcp" Description="Port used for device and controller communication." Type="Port" Display="always" Required="false" Mask="false">8080</Config>
  <Config Name="Port used for controller GUI/API as seen in a web browser" Target="8443" Default="" Mode="tcp" Description="Port used for controller GUI/API as seen in a web browser" Type="Port" Display="always" Required="false" Mask="false">8443</Config>
  <Config Name="Port used for HTTP portal redirection." Target="8880" Default="" Mode="tcp" Description="Port used for HTTP portal redirection." Type="Port" Display="always" Required="false" Mask="false">8880</Config>
  <Config Name="Port used for HTTPS portal redirection." Target="8843" Default="" Mode="tcp" Description="8843" Type="Port" Display="always" Required="false" Mask="false">8843</Config>
  <Config Name="Port used for AP discovery" Target="10001" Default="" Mode="udp" Description="Port used for AP discovery" Type="Port" Display="always" Required="false" Mask="false">10001</Config>
  <Config Name="Traefik Docker Network" Target="traefik.docker.network" Default="host" Mode="" Description="" Type="Label" Display="always" Required="false" Mask="false">host</Config>
  <Config Name="Traefik HTTP URL" Target="traefik.http.services.unifi.loadbalancer.server.url" Default="https://192.168.4.2:8443/" Mode="" Description="" Type="Label" Display="always" Required="false" Mask="false">https://192.168.4.2:8443/</Config>
  <Config Name="Traefik HTTP Transport" Target="traefik.http.services.unifi.loadbalancer.serversTransport" Default="unifi-transport" Mode="" Description="" Type="Label" Display="always" Required="false" Mask="false">ignorecert@file</Config>
  <Config Name="appdata" Target="/config" Default="" Mode="rw" Description="" Type="Path" Display="advanced" Required="false" Mask="false">/mnt/user/appdata/unifi-controller</Config>
  <Config Name="PUID" Target="PUID" Default="" Mode="" Description="" Type="Variable" Display="advanced" Required="false" Mask="false">99</Config>
  <Config Name="PGID" Target="PGID" Default="" Mode="" Description="" Type="Variable" Display="advanced" Required="false" Mask="false">100</Config>
  <TailscaleStateDir/>
</Container>
