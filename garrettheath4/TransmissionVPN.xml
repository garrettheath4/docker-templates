  <Config Name="Host Path 4" Target="/config" Default="/mnt/user/appdata/Transmission_VPN" Mode="rw" Description="" Type="Path" Display="always" Required="true" Mask="false">/mnt/user/appdata/Transmission_VPN</Config>
  <TailscaleStateDir/>
